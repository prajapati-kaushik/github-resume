---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	heading?: string;
	description: string;
	canonicalPath: string;
	meta?: string;
}

const { title, heading = title, description, canonicalPath, meta } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} type="article">
	<section class="section page-head">
		{meta && <p class="eyebrow">{meta}</p>}
		<h1>{heading}</h1>
		<p class="lead">{description}</p>
	</section>
	<section class="section">
		<div class="prose">
			<slot />
		</div>
	</section>
</BaseLayout>
