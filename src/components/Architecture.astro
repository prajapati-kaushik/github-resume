---
import { site } from '../data/site';
---

<section class="section split-overview" id="approach" aria-labelledby="approach-heading">
	<div>
		<p class="eyebrow">How I work</p>
		<h2 id="approach-heading">Independent. Clear. Product stays up.</h2>
	</div>
	<div class="feature-list">
		{
			site.approach.map((item, index) => (
				<article>
					<p class="meta">0{index + 1}</p>
					<h3>{item.title}</h3>
					<p>{item.body}</p>
				</article>
			))
		}
	</div>
</section>
