---
import Button from './Button.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<section class="section about-closing" id="contact" aria-labelledby="contact-heading">
	<p class="eyebrow">Contact</p>
	<h2 id="contact-heading">{site.contact.heading}</h2>
	<p class="lead">{site.contact.body}</p>
	{site.availability && <p class="availability-note">{site.availability}</p>}
	<div class="action-row">
		<Button href={`mailto:${site.email}`}>Start a conversation</Button>
		<Button href={site.phoneHref} variant="ghost">Call</Button>
		<Button href={url('/contact/')} variant="ghost">All contact details</Button>
	</div>
</section>
