---
import { url } from '../lib/url';

interface Props {
	excerpt: string;
}

const { excerpt } = Astro.props;
---

<section class="section split-overview" id="about" aria-labelledby="about-heading">
	<div>
		<p class="eyebrow">Profile</p>
		<h2 id="about-heading">Remote from India. EU hours. Product work that lasts.</h2>
	</div>
	<div class="prose-stack">
		<p class="lead">{excerpt}</p>
		<p>
			<a class="text-link" href={url('/about/')}>About and CV</a>
		</p>
	</div>
</section>
