---
import { site } from '../data/site';
---

<section class="section split-overview" id="expertise" aria-labelledby="expertise-heading">
	<div>
		<p class="eyebrow">Freelance / contract</p>
		<h2 id="expertise-heading">What I bring to a team.</h2>
	</div>
	<div class="feature-list">
		{
			site.expertise.map((item) => (
				<article>
					<h3>{item.title}</h3>
					<p>{item.body}</p>
				</article>
			))
		}
	</div>
</section>
