---
import type { GithubRepository } from '../lib/github';

interface Props {
	repo: GithubRepository;
}

const { repo } = Astro.props;
const updated = repo.updatedAt
	? new Date(repo.updatedAt).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })
	: null;
---

<article class="highlight-card">
	<div>
		<p class="meta">{repo.language ?? 'Repository'}</p>
		<h3>
			<a href={repo.htmlUrl}>{repo.name}</a>
		</h3>
		<p>{repo.description}</p>
		<p class="meta">{repo.stars} stars{updated ? ` · ${updated}` : ''}</p>
		<div class="card-links">
			<a class="text-link" href={repo.htmlUrl}>GitHub</a>
		</div>
	</div>
</article>
